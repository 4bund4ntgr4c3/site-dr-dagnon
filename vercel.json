{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/agenda-reminders",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/event-reminders",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/agenda-reminders.ts": {
      "maxDuration": 60
    },
    "api/event-reminders.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/articles",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/fr/articles",
      "destination": "/fr/publications",
      "permanent": true
    },
    {
      "source": "/en/articles",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/tribunes",
      "permanent": true
    },
    {
      "source": "/fr/blog",
      "destination": "/fr/tribunes",
      "permanent": true
    },
    {
      "source": "/en/blog",
      "destination": "/tribunes",
      "permanent": true
    },
    {
      "source": "/media/publication",
