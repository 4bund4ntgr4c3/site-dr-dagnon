    {
      "source": "/fr/podcast",
      "destination": "/fr/podcasts",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/projets",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/presse",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "/parcours",
      "permanent": true
    },
    {
      "source": "/cv",
      "destination": "/parcours",
      "permanent": true
    },
    {
      "source": "/fr/cv",
      "destination": "/fr/parcours",
      "permanent": true
