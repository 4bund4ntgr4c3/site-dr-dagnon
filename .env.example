# Copy to .env (local) or set in Vercel > Settings > Environment Variables.
# Only RESEND_API_KEY + CONTACT_TO_EMAIL are required for the contact form.

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <admin@seynudedagnon.com>
CONTACT_PHONE=

# ── Newsletter ──────────────────────────────────────────────────
NEWSLETTER_TO_EMAIL=
NEWSLETTER_FROM_EMAIL=
VERIFY_SECRET=

# ── Security / API ──────────────────────────────────────────────
# Comma-separated origin allowlist (defaults to seynudedagnon.com). Add
# preview domains here if needed: https://site-dr-dagnon-xxx.vercel.app
ALLOWED_ORIGINS=https://seynudedagnon.com,https://www.seynudedagnon.com

# Shared rate-limit store — Vercel KV sets KV_* for you when attached;
# Upstash's own UPSTASH_* pair is read too. Without either, an in-memory
# fallback is used (per-instance, not shared).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin / Crons ───────────────────────────────────────────────
# ADMIN_SECRET gates /api/admin + /api/changelog + push composer.
# CRON_SECRET gates /api/agenda-reminders + /api/event-reminders
# (and is the fallback for admin when ADMIN_SECRET is unset).
ADMIN_SECRET=
CRON_SECRET=

# ── Web Push (VAPID) ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
